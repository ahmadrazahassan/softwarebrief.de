NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public canonical origin; defaults to https://softwarebrief.de in data/operator.ts.
NEXT_PUBLIC_SITE_URL=

# resend = real delivery | dev = local test mode only | aus or empty = signup unavailable.
NEWSLETTER_PROVIDER=
# Server secrets: never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Optional separate Full access key for Contacts; defaults to RESEND_API_KEY.
RESEND_CONTACTS_API_KEY=
RESEND_FROM_EMAIL="Softwarebrief <niklas.winterfeld@softwarebrief.de>"
# Created by node scripts/configure-resend.mjs, using the Full access key.
RESEND_SEGMENT_ID=
# Generate a persistent random secret of at least 32 characters; preserve it between deployments.
NEWSLETTER_TOKEN_SECRET=

# Cloudinary media. Only the cloud name may be exposed to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PDF_DELIVERY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
